{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "firebase-hosting",
      "runtimeExecutable": "firebase",
      "runtimeArgs": ["serve", "--only", "hosting", "--port", "5003"],
      "port": 5003
    },
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5001", "--directory", "public"],
      "port": 5001
    }
  ]
}
